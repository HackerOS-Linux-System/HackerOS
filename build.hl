;; =====================================================================
;; EDYCJE
;; =====================================================================

: print_help def
    ~> Użycie: hl build.hl [FLAGA]
    ~>
    ~> Bez flagi – standardowy build HackerOS (official).
    ~>
    ~> Dostępne flagi edycji (tylko jedna naraz):
    ~>   --gaming                 Edycja gamingowa
    ~>   --blue                   Edycja Blue
    ~>   --hydra                  Edycja Hydra
    ~>   --lts                    Edycja LTS
    ~>   --gnome                  Edycja GNOME
    ~>   --xfce                   Edycja XFCE
    ~>   --atomic                 Edycja Atomic
    ~>   --nvidia                 Dodatek NVIDIA
    ~>   --cybersecurity          Edycja Cybersecurity
    ~>   --cybersecurity-default  Edycja Cybersecurity Default
    ~>   --container              Kontener HackerOS-Builder
    ~>   --server                 Edycja Server (placeholder)
    ~>   --help                   Ta pomoc
done

: parse_flag def
    % selected: str =
    @ a in @arg1 @arg2 @arg3 @arg4 @arg5 @arg6 @arg7 @arg8 @arg9
        > echo @a | grep -E '^--' |> @_flag
        ? ok
            > echo @_flag | sed 's/^--//' |> @flag
            ? @flag == help
                -- print_help
                > exit 0
            done
            ? @selected != 
                ~> @COLOR_RED Błąd: można podać tylko jedną flagę edycji (już wybrano --@selected, otrzymano --@flag) @COLOR_RESET
                > exit 1
            done
            % selected = @flag
        done
    done
    ~> @selected
done

