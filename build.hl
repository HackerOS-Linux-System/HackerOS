% USR_LIB: str          = config/includes.chroot_after_packages/usr/lib
% USR_LOCAL_BIN: str    = config/includes.chroot_after_packages/usr/local/bin
% USR_LIBEXEC: str      = config/includes.chroot_after_packages/usr/libexec
