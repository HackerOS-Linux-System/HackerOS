: step_apply_boot_splash def
    -- heading "Podmiana tła bootloadera (splash.svg) na grafikę HackerOS"

    > test -e @OUR_SPLASH
    ? err
        ~> @COLOR_RED Błąd: nie znaleziono @OUR_SPLASH @COLOR_RESET
        > exit 1
    done

    > test -d @LB_BOOTLOADERS_DIR
    ? err
        ~> Ostrzeżenie: katalog @LB_BOOTLOADERS_DIR nie istnieje – pomijam podmianę tła
        ;; return
    done

    > test -e @SYSTEM_SPLASH
    ? ok
        -- sh "sudo cp -f @OUR_SPLASH @SYSTEM_SPLASH"
        ~> Podmieniono @SYSTEM_SPLASH na @OUR_SPLASH
    done

    ;; dodatkowe splash.svg i splash.png
    > find @LB_BOOTLOADERS_DIR -mindepth 2 -type f -name 'splash.svg' 2>/dev/null |> @_svgs
    @ path in @_svgs
        ~> Znaleziono dodatkowy plik tła (svg): @path – podmieniam
        -- sh "sudo cp -f @OUR_SPLASH @path"
    done

    > find @LB_BOOTLOADERS_DIR -mindepth 2 -type f -name 'splash.png' 2>/dev/null |> @_pngs
    @ path in @_pngs
        ~> Znaleziono dodatkowy plik tła (png): @path
        > command -v rsvg-convert >/dev/null 2>&1
        ? ok
            -- sh "rsvg-convert @OUR_SPLASH -o /tmp/hackeros-splash.png" true
            -- sh "sudo cp -f /tmp/hackeros-splash.png @path" true
        done
        ? err
            > command -v convert >/dev/null 2>&1
            ? ok
                -- sh "convert @OUR_SPLASH /tmp/hackeros-splash.png" true
                -- sh "sudo cp -f /tmp/hackeros-splash.png @path" true
            done
            ? err
                ~> Ostrzeżenie: brak rsvg-convert/convert – pomijam @path
            done
        done
    done

    ~> Podmiana tła bootloadera zakończona.
done

: step_run_build def
    ;; $1 = edition
    % build_script: str = "build/build-hackeros"

    ? @1 == gaming
        % build_script = "build/build-hackeros-gaming"
    done
    ? @1 == blue
        % build_script = "build/build-hackeros-blue"
    done
    ? @1 == hydra
        % build_script = "build/build-hackeros-hydra"
    done
    ? @1 == lts
        % build_script = "build/build-hackeros-lts"
    done
    ? @1 == gnome
        % build_script = "build/build-hackeros-gnome"
    done
    ? @1 == xfce
        % build_script = "build/build-hackeros-xfce"
    done
    ? @1 == atomic
        % build_script = "build/build-hackeros-atomic"
    done
    ? @1 == nvidia
        % build_script = "build/build-hackeros-nvidia"
    done
    ? @1 == cybersecurity
        % build_script = "build/build-hackeros-cybersecurity"
    done
    ? @1 == cybersecurity-default
        % build_script = "build/build-hackeros-cybersecurity-default"
    done
    ? @1 == container
        % build_script = "build/build-hackeros-container"
    done
    ? @1 == server
        ~> Uwaga: flaga --server jest obecnie placeholderem. Uruchamiam standardowy build-hackeros.
    done

    -- heading "Wszystkie operacje plikowe zakończone. Uruchamianie @build_script"

    > test -e @build_script
    ? ok
        -- chmodx @build_script
        -- sh "lua5.5 @build_script"
    done
    ? err
        ~> @COLOR_RED Błąd: Skrypt @build_script nie istnieje! @COLOR_RESET
        > exit 1
    done
done

;; =====================================================================
;; MAIN
;; =====================================================================

: main def
    -- parse_flag
    % edition: str = @_

    ~> === Rozpoczynanie przygotowania struktury systemu HackerOS
    ? @edition != 
        ~> (edycja: --@edition)
    done
    ~> ===

    -- step_clone_updates_repo
    -- step_download_apps
    -- step_download_bin_tools @edition
    -- step_extract_archives
    -- step_copy_desktop_files
    -- step_cleanup_updates_repo

    -- step_download_vivaldi @edition

    -- step_download_hackeros_hacker_tools
    -- step_download_steam_bin @edition
    -- step_download_games
    -- step_hacker_lang
    -- step_hnm_skel
    -- step_python_venv
    -- step_chmod_static_files

    ? @edition == gaming
        -- step_copy_gaming_helpers
        -- step_download_gaming_cli_tools
    done

    ? @edition == hydra
        -- step_hydra_pre_build
    done
    ? @edition == lts
        -- step_lts_pre_build
    done
    ? @edition == gnome
        -- step_gnome_pre_build
    done
    ? @edition == xfce
        -- step_xfce_pre_build
    done
    ? @edition == nvidia
        -- step_nvidia_pre_build
    done
    ? @edition == atomic
        -- step_atomic_pre_build
    done
    ? @edition == container
        -- step_container_pre_build
    done

    ? @edition != container
        -- step_apply_boot_splash
    done

    -- step_run_build @edition
done

-- main
