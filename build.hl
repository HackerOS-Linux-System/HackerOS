% VER_CHKER: str    = $( -- manifest_version "chker" )
% VER_GETIT: str    = $( -- manifest_version "getit" )
% VER_STEAM: str    = $( -- manifest_version "HackerOS Steam" )
% VER_HSH: str      = $( -- manifest_version "hsh" )
% VER_NGT: str      = $( -- manifest_version "ngt" )
% VER_HEDIT: str    = $( -- manifest_version "hedit" )

% VER_GAMES: str    = $( -- manifest_version "HackerOS Games" )
