#!/usr/bin/hl
using <gen 2>

# <main/colors>

;; =====================================================================
;; FUNKCJE POMOCNICZE
;; =====================================================================

: quote def
    ;; proste otaczanie apostrofami (wystarczy do większości ścieżek)
    ~> '@1'
done

: sh def
    ;; $1 = komenda, $2 = allow_fail (opcjonalnie "true")
    ~> + @1
    > @1
    ? ok
        ;; sukces
    done
    ? err
        ? @2 == true
            ~> @COLOR_YELLOW Ostrzeżenie: polecenie nie powiodło się (kontynuuję): @1 @COLOR_RESET
        done
        ? @2 != true
            ~> @COLOR_RED Błąd: polecenie nie powiodło się: @1 @COLOR_RESET
            > exit 1
        done
    done
done

: capture def
    > @1 |> @_out
    ~> @_out
done

: exists def
    > test -e @1
    ? ok
        ~> true
    done
    ? err
        ~> false
    done
done

: isdir def
    > test -d @1
    ? ok
        ~> true
    done
    ? err
        ~> false
    done
done

: mkdirp def
    -- sh "mkdir -p @1"
done

: rmrf def
    -- sh "rm -rf @1"
done

: download def
    -- sh "curl -fL -o @2 @1"
done

: chmodx def
    -- sh "chmod +x @1"
done

: chmodx_if_exists def
    > test -e @1
    ? ok
        -- chmodx @1
    done
    ? err
        ~> @COLOR_YELLOW Ostrzeżenie: plik nie istnieje, pomijam chmod: @1 @COLOR_RESET
    done
done

: clone def
    -- rmrf @2
    -- sh "git clone --depth 1 @1 @2"
done

: heading def
    ~>
    ~> === @1 ===
done

;; =====================================================================
;; PARSOWANIE packages/manifest.hk → sekcja [tools]
;; =====================================================================

% MANIFEST_PATH: str = packages/manifest.hk

: parse_manifest_tools def
    > test -f @MANIFEST_PATH
    ? err
        ~> @COLOR_RED Błąd: nie znaleziono pliku manifestu: @MANIFEST_PATH @COLOR_RESET
        > exit 1
    done

    ;; ekstrahujemy linie z sekcji [tools] i zapisujemy do tymczasowego pliku
    ;; format: -> "Nazwa z odstępami" => vX.Y   lub   -> nazwa => vX.Y
    > awk '
        /^\[tools\]/ { in_tools=1; next }
        /^\[/ { in_tools=0 }
        in_tools && /->/ {
            # usuń wiodące spacje i "->"
            sub(/^[ \t]*->[ \t]*/, "")
            # jeśli jest cudzysłów – wyciągnij zawartość
            if (match($0, /"([^"]+)"[ \t]*=>[ \t]*(.+)/, a)) {
                print a[1] "|" a[2]
            } else if (match($0, /([^ \t]+)[ \t]*=>[ \t]*(.+)/, a)) {
                print a[1] "|" a[2]
            }
        }
    ' @MANIFEST_PATH |> @_tools_raw

    ~> @_tools_raw
done

: manifest_version def
    ;; $1 = nazwa narzędzia
    -- parse_manifest_tools
    % found: str = false
    % ver: str =

    @ line in @_tools_raw
        > echo @line | cut -d'|' -f1 |> @name
        > echo @line | cut -d'|' -f2 |> @v
        ? @name == @1
            % found = true
            % ver = @v
        done
    done

    ? @found == false
        ~> @COLOR_RED Błąd: brak wpisu "@1" w sekcji [tools] pliku @MANIFEST_PATH @COLOR_RESET
        > exit 1
    done
    ~> @ver
done

;; Wersje – odczytywane leniwie (jak w oryginale dla narzędzi container)
