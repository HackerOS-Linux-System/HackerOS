: step_download_vivaldi def
    ;; $1 = edition
    ? @1 == cybersecurity
        -- heading "Tryb --@1: pomijam pobieranie przeglądarki Vivaldi"
        ;; return
    done
    ? @1 == cybersecurity-default
        -- heading "Tryb --@1: pomijam pobieranie przeglądarki Vivaldi"
        ;; return
    done

    -- heading "Sprawdzanie najnowszej wersji Vivaldi"

    % url_base: str = "https://vivaldi.com/download/vivaldi-stable_amd64.deb"
    > curl -sIL -o /dev/null -w "%{url_effective}" @url_base |> @url_effective
    > echo @url_effective | sed 's|.*/||' |> @file_name
    % target_file: str = "@PACKAGES_CHROOT/@file_name"

    ~> Najnowszy adres URL: @url_effective
    ~> Docelowy plik: @target_file

    > test -e @target_file
    ? ok
        ~> Plik @file_name już istnieje. Jest aktualny.
        ;; return
    done

    > test -d @PACKAGES_CHROOT
    ? ok
        -- sh "find @PACKAGES_CHROOT -type f -name 'vivaldi-stable*.deb' ! -name @file_name -delete" true
    done

    -- mkdirp @PACKAGES_CHROOT
    ~> Pobieranie najnowszej wersji Vivaldi...
    -- download @url_effective @target_file
    ~> Gotowe! Plik .deb zapisany w: @target_file
done

