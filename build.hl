    @ entry in @tools
        > echo @entry | cut -d'|' -f1 |> @name
        > echo @entry | cut -d'|' -f2 |> @repo
        > echo @entry | cut -d'|' -f3 |> @ver

        ? @1 == gaming
            ? @name == hackeros-steam
                ~> Tryb --gaming: pomijam pobieranie @name
                ;; continue
            done
        done

        % url: str = "https://github.com/HackerOS-Linux-System/@repo/releases/download/@ver/@name"
        % dest: str = "@TARGET_BIN/@name"
        -- download @url @dest
        -- chmodx @dest
    done
done

