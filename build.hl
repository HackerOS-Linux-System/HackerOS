    @ entry in @apps
        > echo @entry | cut -d'|' -f1 |> @name
        > echo @entry | cut -d'|' -f2 |> @repo
        > echo @entry | cut -d'|' -f3 |> @ver
        % url: str = "https://github.com/HackerOS-Linux-System/@repo/releases/download/@ver/@name"
        % dest: str = "@TARGET_APPS/@name"
        -- download @url @dest
        -- chmodx @dest
    done
done

