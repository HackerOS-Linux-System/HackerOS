#!/usr/bin/env lua5.5

local BINARY_FILE   = "/usr/lib/live/build/binary"
local BINARY_BACKUP = "/usr/lib/live/build/binary.backup"

-- live-build (przy --linux-flavours "none") generuje wpisy bootloadera
-- (GRUB/syslinux) szukające plików /live/vmlinuz-*none oraz
-- /live/initrd.img-*none. Jądro xanmod ma w nazwie np. "6.x-x64v3-xanmod1",
-- więc kopiujemy je do binary/live/ z doklejonym sufiksem "-none", dzięki
-- czemu wzorzec generowany przez live-build trafia w istniejące pliki.
-- (To był błąd: "file `/live/vmlinuz-*none' not found".)
local KERNEL_FLAVOUR_SUFFIX = "none"

-- =====================================================================
-- FUNKCJE POMOCNICZE
-- =====================================================================

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function fail(msg)
    error(msg, 0)
end

local function sh(cmd)
    io.write("+ " .. cmd .. "\n")
    local ok = os.execute(cmd)
    if ok ~= true and ok ~= 0 then
        fail("Błąd: polecenie nie powiodło się: " .. cmd)
    end
    return true
end

local function exists(path)
    return os.execute("test -e " .. quote(path)) == true
end

-- Proste, dosłowne (nie-pattern) wyszukiwanie/zamiana - unika problemów
-- z interpretacją znaków specjalnych Lua-patternów (np. "$", "%").
local function plain_replace(s, old, new, max_count)
    local out, start, n = {}, 1, 0
    while true do
        if max_count and n >= max_count then
            out[#out + 1] = s:sub(start)
            break
        end
        local i, j = s:find(old, start, true)
        if not i then
            out[#out + 1] = s:sub(start)
            break
        end
        out[#out + 1] = s:sub(start, i - 1)
        out[#out + 1] = new
        start = j + 1
        n = n + 1
    end
    return table.concat(out)
end

local function restore_backup()
    if exists(BINARY_BACKUP) then
        io.write("==> Przywracam oryginalny plik...\n")
        os.execute("sudo cp " .. quote(BINARY_BACKUP) .. " " .. quote(BINARY_FILE))
        os.execute("sudo rm " .. quote(BINARY_BACKUP))
    end
end

-- =====================================================================
-- PATCH /usr/lib/live/build/binary
-- =====================================================================

local function patch_binary_script()
    io.write("==> Patchowanie...\n")

    local f = io.open(BINARY_FILE, "r")
    if not f then
        fail("Nie mogę otworzyć do odczytu: " .. BINARY_FILE)
    end
    local content = f:read("*a")
    f:close()

    local old = 'lb binary_syslinux "${@}"'
    local new = table.concat({
        "# [HackerOS] Kopiowanie jadra xanmod do binary/live/ (nazwy z sufiksem -" .. KERNEL_FLAVOUR_SUFFIX .. ")",
        "mkdir -p binary/live",
        "VMLINUZ=$(ls chroot/boot/vmlinuz-*xanmod* 2>/dev/null | sort -V | tail -n1)",
        "INITRD=$(ls chroot/boot/initrd.img-*xanmod* 2>/dev/null | sort -V | tail -n1)",
        'if [ -z "$VMLINUZ" ] || [ -z "$INITRD" ]; then',
        '    echo "E: Brak jadra/initrd xanmod w chroot/boot (VMLINUZ=$VMLINUZ INITRD=$INITRD)" >&2',
        "    exit 1",
        "fi",
        'KVER=$(basename "$VMLINUZ" | sed "s/^vmlinuz-//")',
        "rm -f binary/live/vmlinuz-* binary/live/initrd.img-*",
        'cp "$VMLINUZ" "binary/live/vmlinuz-${KVER}-' .. KERNEL_FLAVOUR_SUFFIX .. '"',
        'cp "$INITRD" "binary/live/initrd.img-${KVER}-' .. KERNEL_FLAVOUR_SUFFIX .. '"',
        'echo "I: xanmod -> binary/live/vmlinuz-${KVER}-' .. KERNEL_FLAVOUR_SUFFIX .. '"',
        'lb binary_syslinux "${@}"',
    }, "\n")

    if not content:find(old, 1, true) then
        fail("Nie znaleziono wzorca do podmiany w " .. BINARY_FILE)
    end

    local patched = plain_replace(content, old, new, 1)

    -- Zapis do systemowego pliku wymaga roota - piszemy do pliku tymczasowego,
    -- a potem podmieniamy go przez sudo cp.
    local tmp = os.tmpname()
    local out = io.open(tmp, "w")
    out:write(patched)
    out:close()

    sh("sudo cp " .. quote(tmp) .. " " .. quote(BINARY_FILE))
    os.remove(tmp)
end

-- =====================================================================
-- HOOK CHROOTOWY: symlinki jądra xanmod
-- =====================================================================

local XANMOD_HOOK_PATH = "config/hooks/normal/0010-xanmod-symlink.hook.chroot"

local XANMOD_HOOK_CONTENT = [[#!/bin/sh
set -e
VMLINUZ=$(ls /boot/vmlinuz-*xanmod* 2>/dev/null | sort -V | tail -n1)
if [ -z "$VMLINUZ" ]; then
    echo "E: Brak jadra xanmod!"
    exit 1
fi
KVER=$(basename "$VMLINUZ" | sed 's/vmlinuz-//')
if [ ! -f "/boot/initrd.img-${KVER}" ]; then
    echo "I: Generowanie initrd dla ${KVER}..."
    update-initramfs -c -k "${KVER}"
fi
INITRD=$(ls /boot/initrd.img-*xanmod* 2>/dev/null | sort -V | tail -n1)
if [ -z "$INITRD" ]; then
    echo "E: Brak initrd xanmod!"
    exit 1
fi
ln -sf "$VMLINUZ" /boot/vmlinuz
ln -sf "$VMLINUZ" /vmlinuz
ln -sf "$INITRD" /boot/initrd.img
ln -sf "$INITRD" /initrd.img
echo "I: Jadro: $VMLINUZ"
echo "I: Initrd: $INITRD"
]]

local function write_xanmod_hook()
    sh("mkdir -p config/hooks/normal")
    local f = io.open(XANMOD_HOOK_PATH, "w")
    if not f then
        fail("Nie mogę utworzyć pliku: " .. XANMOD_HOOK_PATH)
    end
    f:write(XANMOD_HOOK_CONTENT)
    f:close()
    sh("chmod +x " .. quote(XANMOD_HOOK_PATH))
end

-- =====================================================================
-- HOOK BINARY: siatka bezpieczeństwa dla konfiguracji bootloadera
-- =====================================================================
-- Uruchamiany po wygenerowaniu grub.cfg / isolinux.cfg, a przed zbudowaniem
-- ISO. Podmienia ewentualne wzorce "vmlinuz-*none" / "initrd.img-*none" na
-- dokładne nazwy plików z binary/live/ (syslinux nie obsługuje wildcardów,
-- GRUB tak, ale jawne nazwy są pewniejsze) i kończy build błędem, jeśli
-- jądra lub initrd brakuje w obrazie.

local BOOTCFG_HOOK_PATH = "config/hooks/normal/0020-xanmod-bootcfg.hook.binary"

local BOOTCFG_HOOK_CONTENT = [[#!/bin/sh
set -e
BIN=""
for d in binary /binary ../binary; do
    if [ -d "$d/live" ]; then BIN="$d"; break; fi
done
if [ -z "$BIN" ]; then
    echo "W: Nie znaleziono katalogu binary/live - pomijam poprawke konfiguracji bootloadera."
    exit 0
fi
VMLINUZ=$(ls "$BIN"/live/vmlinuz-* 2>/dev/null | sort -V | tail -n1)
INITRD=$(ls "$BIN"/live/initrd.img-* 2>/dev/null | sort -V | tail -n1)
if [ -z "$VMLINUZ" ] || [ -z "$INITRD" ]; then
    echo "E: Brak jadra lub initrd w $BIN/live!" >&2
    exit 1
fi
KNAME=$(basename "$VMLINUZ")
INAME=$(basename "$INITRD")
for f in $(find "$BIN" -type f \( -name '*.cfg' -o -name '*.conf' \) 2>/dev/null); do
    if grep -q -e 'vmlinuz-\*' -e 'initrd.img-\*' "$f" 2>/dev/null; then
        sed -i -e "s|vmlinuz-\*[A-Za-z0-9._+-]*|${KNAME}|g" \
               -e "s|initrd.img-\*[A-Za-z0-9._+-]*|${INAME}|g" "$f"
        echo "I: poprawiono wpisy jadra w $f"
    fi
done
echo "I: Jadro:  $KNAME"
echo "I: Initrd: $INAME"
]]

local function write_bootcfg_hook()
    sh("mkdir -p config/hooks/normal")
    local f = io.open(BOOTCFG_HOOK_PATH, "w")
    if not f then
        fail("Nie mogę utworzyć pliku: " .. BOOTCFG_HOOK_PATH)
    end
    f:write(BOOTCFG_HOOK_CONTENT)
    f:close()
    sh("chmod +x " .. quote(BOOTCFG_HOOK_PATH))
end

-- =====================================================================
-- GŁÓWNA LOGIKA BUILDA
-- =====================================================================

local function main()
    -- Jeśli poprzedni build przerwano (Ctrl+C / crash) i został backup,
    -- przywracamy oryginał, żeby nie zrobić backupu już spatchowanego pliku
    -- i nie dublować patcha.
    restore_backup()

    sh("sudo ln -sf /usr/share/debootstrap/scripts/sid /usr/share/debootstrap/scripts/forky")

    io.write("==> Backup " .. BINARY_FILE .. "...\n")
    sh("sudo cp " .. quote(BINARY_FILE) .. " " .. quote(BINARY_BACKUP))

    patch_binary_script()

    io.write("==> Weryfikacja patcha:\n")
    sh('grep -n -A8 "Kopiowanie jadra" ' .. quote(BINARY_FILE))

    sh("sudo lb clean --purge")

    -- Usuń stare hooki binary, żeby nie przeszkadzały
    os.execute("rm -f config/hooks/normal/0020-xanmod-binary.hook.binary")

    sh(
        "lb config " ..
        "--distribution forky " ..
        "--architectures amd64 " ..
        '--apt-options "--allow-unauthenticated --yes" ' ..
        "--firmware-chroot true " ..
        '--linux-flavours "none" ' ..
        '--linux-packages "none" ' ..
        "--security false " ..
        '--debootstrap-options "--include=gnupg"'
    )

    sh(
        "sudo rm -rf " ..
        quote("config/includes.chroot_after_packages/usr/bin/chker") .. " " ..
        quote("config/includes.chroot_after_packages/usr/bin/hackeros-steam")
    )

    -- (po "lb clean --purge" + "lb config" plik config/chroot jest generowany
    -- od nowa, więc dopisujemy i386 tylko jeśli wpisu jeszcze nie ma)
    if os.execute("grep -qs '^LB_ADD_ARCHITECTURES=' config/chroot") ~= true then
        local f = io.open("config/chroot", "a")
        if not f then
            fail("Nie mogę otworzyć do dopisania: config/chroot")
        end
        f:write('LB_ADD_ARCHITECTURES="i386"\n')
        f:close()
    end

    write_xanmod_hook()
    write_bootcfg_hook()

    sh("sudo lb build")

    io.write("\n==> Gotowe! ISO jest w /home/michal-hackeros/Pobrane/\n")
end

local ok, err = pcall(main)
restore_backup()

if not ok then
    io.stderr:write(tostring(err) .. "\n")
    os.exit(1)
end
