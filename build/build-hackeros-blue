sh("mkdir -p " .. quote(WALLPAPER_DIR))
sh("mkdir -p " .. quote(BIN_DIR))

--------------------------------------------------------------------------
-- 2a. Zapisujemy wybrany domyślny display manager do pliku-znacznika,
--     który hdm.hook.chroot oraz sddm-autologin.hook.chroot odczytują
--     w chroocie przy starcie systemu (patrz BLUE_DEFAULT_DM wyżej).
--------------------------------------------------------------------------
do
    local marker_dir = "config/includes.chroot_after_packages/etc/hackeros"
    sh("mkdir -p " .. quote(marker_dir))
    write_file(marker_dir .. "/blue-default-dm", BLUE_DEFAULT_DM .. "\n")
