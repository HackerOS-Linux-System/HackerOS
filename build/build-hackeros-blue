#!/usr/bin/env lua5.5

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd, allow_fail)
    io.write("+ " .. cmd .. "\n")
    local ok = os.execute(cmd)
    if ok == true or ok == 0 then
        return true
    end
    if allow_fail then
        io.stderr:write("Ostrzeżenie: polecenie nie powiodło się (kontynuuję): " .. cmd .. "\n")
        return false
    end
    io.stderr:write("Błąd: polecenie nie powiodło się: " .. cmd .. "\n")
    os.exit(1)
end

local function download(url, dest, allow_fail)
    sh("wget -q --show-progress -O " .. quote(dest) .. " " .. quote(url), allow_fail)
end

-- Katalogi docelowe
local BLUE_DIR       = "config/includes.chroot_after_packages/usr/share/Blue-Environment"
local WALLPAPER_DIR  = "config/includes.chroot_after_packages/usr/share/wallpapers"

-- POPRAWKA: wcześniej pobieraliśmy pojedyncze binarki (blue-environment,
-- blue-compositor, blue) osobno z releasu "v0.6" - teraz cały wygląd/env
-- jest paczkowany jako jedno archiwum .tar.gz w releasie "snapshot-v0.6",
-- które po prostu rozpakowujemy w całości do BLUE_DIR (usr/share/Blue-Environment).
local RELEASE_BASE  = "https://github.com/HackerOS-Linux-System/Blue-Environment/releases/download/snapshot-v0.6"
local ARCHIVE_URL   = RELEASE_BASE .. "/Blue-Environment.tar.gz"
local ARCHIVE_TMP   = "/tmp/Blue-Environment.tar.gz"

-- Raw URL (blob/tree nie nadają się do pobierania bezpośrednio)
local WALLPAPER_URL = "https://raw.githubusercontent.com/HackerOS-Linux-System/Blue-Environment/main/images/default.png"

--------------------------------------------------------------------------
-- 1. Kopiujemy zawartość helpers/blue/* do config/
--------------------------------------------------------------------------
sh("mkdir -p config")
sh("cp -r helpers/blue/. config/")

--------------------------------------------------------------------------
-- 2. Tworzymy potrzebne katalogi
--------------------------------------------------------------------------
sh("mkdir -p " .. quote(BLUE_DIR))
sh("mkdir -p " .. quote(WALLPAPER_DIR))

--------------------------------------------------------------------------
-- 3. Pobieramy i rozpakowujemy archiwum Blue-Environment.tar.gz
--------------------------------------------------------------------------
download(ARCHIVE_URL, ARCHIVE_TMP)
sh("tar -xzf " .. quote(ARCHIVE_TMP) .. " -C " .. quote(BLUE_DIR))
sh("rm -f " .. quote(ARCHIVE_TMP))

-- Wszystko, co było w archiwum, powinno być uruchamialne (skrypty/binarki
-- środowiska graficznego) - nadajemy prawa wykonywania rekurencyjnie tylko
-- plikom (nie katalogom), żeby nie zepsuć uprawnień np. plikom konfiguracyjnym
-- w sposób niezamierzony; jeśli archiwum ma już poprawne uprawnienia, to i
-- tak nic złego się nie stanie.
sh("find " .. quote(BLUE_DIR) .. " -maxdepth 2 -type f -name 'blue*' -exec chmod a+x {} +", true)

--------------------------------------------------------------------------
-- 4. Pobieramy domyślną tapetę (best-effort - nie przerywamy builda, jeśli
--    ten konkretny plik akurat zniknął/zmienił ścieżkę w repo Blue-Environment;
--    tapeta jest kosmetyczna, w przeciwieństwie do samego środowiska).
--------------------------------------------------------------------------
download(WALLPAPER_URL, WALLPAPER_DIR .. "/default.png", true)

--------------------------------------------------------------------------
-- 5. Pobieramy binarki bedm / bedm-greeter do /usr/bin
--------------------------------------------------------------------------
-- POPRAWKA: te binarki wcześniej trafiały (błędnie) do
-- build/build-hackeros-cybersecurity-default - to binarki środowiska Blue,
-- więc ich miejsce jest tutaj, w build-hackeros-blue.
local BIN_DIR = "config/includes.chroot_after_packages/usr/bin"
sh("mkdir -p " .. quote(BIN_DIR))
for _, name in ipairs({ "bedm", "bedm-greeter" }) do
    local dest = BIN_DIR .. "/" .. name
    download(RELEASE_BASE .. "/" .. name, dest)
    sh("chmod a+x " .. quote(dest))
end

--------------------------------------------------------------------------
-- Dalej: właściwy build live-build
--------------------------------------------------------------------------

-- Debootstrap nie zna jeszcze "forky" jako takiego - podpinamy go pod skrypt "sid"
sh("sudo ln -sf /usr/share/debootstrap/scripts/sid /usr/share/debootstrap/scripts/forky")

-- Czyścimy poprzednie buildy
sh("sudo lb clean --purge")

-- Konfiguracja live-build z firmware i repo non-free-firmware
sh(
    "lb config " ..
    "--distribution forky " ..
    "--architectures amd64 " ..
    '--apt-options "--allow-unauthenticated --yes" ' ..
    "--firmware-chroot true " ..
    "--security false " ..
    '--debootstrap-options "--include=gnupg"'
)

-- Budowa obrazu
sh("sudo lb build")
