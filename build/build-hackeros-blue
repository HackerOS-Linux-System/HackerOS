-- istniejący to v0.1 (zawiera hdm oraz hdm-greeter).
local HDM_BASE       = "https://github.com/HackerOS-Linux-System/HDM/releases/download/v0.1"

-- Raw URL (blob/tree nie nadają się do pobierania bezpośrednio)
local WALLPAPER_URL = "https://raw.githubusercontent.com/HackerOS-Linux-System/Blue-Environment/main/images/default.png"

-- Skrypty narzędziowe "blue" (CLI do zarządzania środowiskiem) oraz
-- "blue-dev" (CLI do budowania paczek .blue) - pobierane jako surowe pliki
-- z gałęzi main repo Blue-Environment (scripts/tools/) prosto do /usr/bin.
local BLUE_TOOLS_BASE = "https://raw.githubusercontent.com/HackerOS-Linux-System/Blue-Environment/main/scripts/tools"

--------------------------------------------------------------------------
-- 1. Kopiujemy zawartość helpers/blue/* do config/
--------------------------------------------------------------------------
sh("mkdir -p config")
sh("cp -r helpers/blue/. config/")

--------------------------------------------------------------------------
-- 2. Tworzymy potrzebne katalogi
--------------------------------------------------------------------------
