#!/usr/bin/env lua5.5

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd, allow_fail)
    io.write("+ " .. cmd .. "\n")
    local ok = os.execute(cmd)
    if ok == true or ok == 0 then
        return true
    end
    if allow_fail then
        io.stderr:write("Ostrzeżenie: polecenie nie powiodło się (kontynuuję): " .. cmd .. "\n")
        return false
    end
    io.stderr:write("Błąd: polecenie nie powiodło się: " .. cmd .. "\n")
    os.exit(1)
end

local function download(url, dest, allow_fail)
    sh("wget -q --show-progress -O " .. quote(dest) .. " " .. quote(url), allow_fail)
end

local function heading(text)
    io.write("\n========================================================\n")
    io.write("  " .. text .. "\n")
    io.write("========================================================\n")
end

local function write_file(path, content)
    local f = assert(io.open(path, "w"))
    f:write(content)
    f:close()
end

-- POPRAWKA BLEDU: zamiast trzymac tu na sztywno numer tagu releasu (co
-- regularnie psulo sie przy kazdej nowej wersji hackeros-comp -- 404,
-- trzeba bylo recznie poprawiac ten plik za kazdym razem), pytamy GitHub
-- API o NAJNOWSZY release i szukamy w nim assetu o dokladnie podanej
-- nazwie. To samo API co poprawiony hook heroic-games-launcher; jesli
-- host przekazal GITHUB_TOKEN do srodowiska, korzystamy z niego (wyzszy
-- limit zapytan), ale dzialamy poprawnie rowniez bez niego.
local function latest_release_asset_url(repo, asset_name)
    local auth = ""
    local token = os.getenv("GITHUB_TOKEN")
    if token and token ~= "" then
        auth = "-H " .. quote("Authorization: Bearer " .. token) .. " "
    end
    local api_url = "https://api.github.com/repos/" .. repo .. "/releases/latest"
    local cmd = "curl -fsS " .. auth .. quote(api_url) ..
        " | jq -r " .. quote('.assets[]? | select(.name == "' .. asset_name .. '") | .browser_download_url')
    local handle = io.popen(cmd)
    local url = handle and handle:read("*l") or nil
    if handle then handle:close() end
    if url == nil or url == "" or url == "null" then
        io.stderr:write("Błąd: nie udało się znaleźć assetu '" .. asset_name ..
            "' w najnowszym releasie " .. repo .. " (zapytanie do " .. api_url .. ")\n")
        os.exit(1)
    end
    return url
end

-- Skąd wziąć binarkę blue-environment - sterowane zmiennymi środowiskowymi
-- (ustawianymi np. przez .github/workflows/build-blue.yml, patrz tam):
--   BLUE_ENV_SOURCE  = "release" (domyślnie) albo "source"
--   BLUE_ENV_VERSION = tag releasu do pobrania, gdy BLUE_ENV_SOURCE=release
--                       ("latest" = najnowszy dostępny release, dynamicznie
--                       przez GitHub API - tak jak HACKEROS_COMP_URL niżej;
--                       domyślnie "v0.8", czyli dotychczasowe, na sztywno
--                       przypięte zachowanie tego skryptu)
--   BLUE_ENV_REF     = gałąź/tag/commit do zbudowania, gdy BLUE_ENV_SOURCE=source
--                       (domyślnie "main")
local BLUE_ENV_SOURCE  = (os.getenv("BLUE_ENV_SOURCE") or "release"):lower()
local BLUE_ENV_VERSION = os.getenv("BLUE_ENV_VERSION") or "v0.8"
local BLUE_ENV_REF     = os.getenv("BLUE_ENV_REF") or "main"
local BLUE_ENVIRONMENT_REPO = "HackerOS-Linux-System/Blue-Environment"

-- Domyślny display manager edycji Blue. Obsługiwane wartości:
--   "sddm"    (domyślnie) - patrz helpers/blue/hooks/normal/sddm-autologin.hook.chroot
--   "hdm"     - HackerOS Display Manager, patrz helpers/blue/hooks/normal/hdm.hook.chroot
--   "lightdm" - LightDM + lightdm-gtk-greeter, patrz helpers/blue/hooks/normal/lightdm.hook.chroot
--   "gdm"     - GDM (pakiet Debiana: gdm3), patrz helpers/blue/hooks/normal/gdm.hook.chroot
-- SDDM i HDM (o ile wybrano hdm) trafiają do obrazu ISO niezależnie od
-- wyboru (można ręcznie przełączyć się na inny po zainstalowaniu/uruchomieniu
-- systemu). LightDM i GDM są doinstalowywane WYŁĄCZNIE, gdy zostały wybrane
-- (patrz generowana lista pakietów blue-display-manager.list.chroot niżej -
-- GDM ciągnie za sobą spory kawałek stosu GNOME, więc nie ma sensu pakować
-- go do każdego obrazu). Ten wybór decyduje o tym, który z menedżerów hooki
-- włączą jako faktyczny display-manager przy starcie systemu (plik-znacznik
-- /etc/hackeros/blue-default-dm, odczytywany przez wszystkie hooki).
local SUPPORTED_DMS = { "sddm", "hdm", "lightdm", "gdm" }
local BLUE_DEFAULT_DM = (os.getenv("BLUE_DEFAULT_DM") or "sddm"):lower()
do
    local known = false
    for _, name in ipairs(SUPPORTED_DMS) do
        if name == BLUE_DEFAULT_DM then known = true end
    end
    if not known then
        io.stderr:write("Błąd: nieznana wartość BLUE_DEFAULT_DM: '" .. BLUE_DEFAULT_DM ..
            "' (oczekiwano: " .. table.concat(SUPPORTED_DMS, ", ") .. ")\n")
        os.exit(1)
    end
end

-- Wariant interfejsu (UI) powłoki Blue Environment budowanej ze źródeł:
--   "default" - klasyczny pulpit (komputery) - dotychczasowe zachowanie,
--   "phones"  - interfejs dla telefonów (src/phones w repo Blue-Environment),
--   "tv"      - interfejs dla telewizorów (src/tv w repo Blue-Environment).
-- Dotyczy WYŁĄCZNIE BLUE_ENV_SOURCE=source - gotowa binarka z GitHub
-- Releases jest zawsze budowana z domyślnym UI.
local BLUE_ENV_UI = (os.getenv("BLUE_ENV_UI") or "default"):lower()
if BLUE_ENV_UI ~= "default" and BLUE_ENV_UI ~= "phones" and BLUE_ENV_UI ~= "tv" then
    io.stderr:write("Błąd: nieznana wartość BLUE_ENV_UI: '" .. BLUE_ENV_UI ..
        "' (oczekiwano: default, phones albo tv)\n")
    os.exit(1)
end
if BLUE_ENV_UI ~= "default" and BLUE_ENV_SOURCE ~= "source" then
    io.stderr:write("Błąd: BLUE_ENV_UI=" .. BLUE_ENV_UI .. " wymaga BLUE_ENV_SOURCE=source " ..
        "(gotowe binarki z GitHub Releases mają zawsze domyślny interfejs komputerowy).\n")
    os.exit(1)
end

-- Katalogi docelowe
local BLUE_DIR       = "config/includes.chroot_after_packages/usr/share/Blue-Environment"
local WALLPAPER_DIR  = "config/includes.chroot_after_packages/usr/share/wallpapers"
local BIN_DIR        = "config/includes.chroot_after_packages/usr/bin"

-- POPRAWKA: zamiast pobierać jedno wspólne archiwum .tar.gz (które trafiało
