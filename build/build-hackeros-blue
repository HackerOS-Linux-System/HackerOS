--------------------------------------------------------------------------
-- 2b. Pakiety wybranego display managera.
--     sddm jest już na liście helpers/blue/package-lists/live.list.chroot
--     (zawsze), a HDM to binarki pobierane niżej - więc generujemy
--     dodatkową listę pakietów TYLKO dla lightdm i gdm. live-build łączy
--     wszystkie pliki *.list.chroot z config/package-lists/.
--------------------------------------------------------------------------
do
    local DM_PACKAGES = {
        -- lightdm-gtk-greeter: bez greetera LightDM nie ma czym narysować
        -- ekranu logowania (Debian daje go tylko jako Recommends).
        lightdm = { "lightdm", "lightdm-gtk-greeter", "accountsservice" },
        -- gdm3: nazwa pakietu Debiana. Greeter GDM działa na gnome-shell,
        -- a Debian wskazuje go tylko jako Recommends - dopisujemy jawnie, żeby
        -- ekran logowania nie startował "na ślepo". accountsservice trzyma
        -- wybraną sesję użytkownika (patrz gdm.hook.chroot).
        gdm     = { "gdm3", "gnome-shell", "gnome-session-bin", "accountsservice" },
    }
    local pkgs = DM_PACKAGES[BLUE_DEFAULT_DM]
    if pkgs then
        sh("mkdir -p config/package-lists")
        write_file("config/package-lists/blue-display-manager.list.chroot",
            "# Wygenerowane przez build/build-hackeros-blue (BLUE_DEFAULT_DM=" .. BLUE_DEFAULT_DM .. ")\n" ..
            table.concat(pkgs, "\n") .. "\n")
        heading("Dodatkowe pakiety display managera (" .. BLUE_DEFAULT_DM .. "): " .. table.concat(pkgs, " "))
    end
end

--------------------------------------------------------------------------
-- FUNKCJE: pozyskanie binarki blue-environment (source vs release)
--------------------------------------------------------------------------

-- Buduje blue-environment ze źródeł (git clone + npm + cargo/Tauri) i
-- kopiuje gotową binarkę do "dest". Wymaga npm/node oraz Rust/cargo (plus
-- systemowych nagłówków webkit2gtk/Tauri) już zainstalowanych na
-- runnerze/hoście - patrz .github/workflows/build-blue.yml, który
-- instaluje je WYŁĄCZNIE gdy wybrano tryb "source".
local function build_blue_environment_from_source(dest)
    heading("Budowanie blue-environment ze źródeł (ref: " .. BLUE_ENV_REF .. ")")

    local src = "/tmp/blue-environment-src"
    sh("rm -rf " .. quote(src))
    -- "--no-checkout" + "git fetch"/"git checkout FETCH_HEAD" zamiast
    -- "git clone --branch", żeby BLUE_ENV_REF mogło być zarówno gałęzią,
    -- tagiem, jak i "gołym" (surowym) SHA commita.
    sh("git clone --no-checkout https://github.com/" .. BLUE_ENVIRONMENT_REPO .. ".git " .. quote(src))
    sh("cd " .. quote(src) .. " && git fetch --depth 1 origin " .. quote(BLUE_ENV_REF) ..
        " && git checkout FETCH_HEAD")

    -- Wariant UI (default/phones/tv): dla phones/tv sprawdzamy, czy wskazany
    -- ref repo Blue-Environment w ogóle zawiera odpowiedni katalog z kodem
    -- (src/phones, src/tv) - starsze commity go nie mają, a bez tej kontroli
    -- build po cichu skończyłby się zwykłym, komputerowym interfejsem.
    if BLUE_ENV_UI ~= "default" then
        sh("test -d " .. quote(src .. "/src/" .. BLUE_ENV_UI) .. " || (echo 'Błąd: ref " ..
            BLUE_ENV_REF .. " repozytorium Blue-Environment nie zawiera katalogu src/" ..
            BLUE_ENV_UI .. " (interfejs " .. BLUE_ENV_UI .. " nie jest w nim dostępny).' >&2 && exit 1)")
        heading("Wariant interfejsu Blue Environment: " .. BLUE_ENV_UI)
    end

    sh("cd " .. quote(src) .. " && npm install")

    -- Mirror "beforeBuildCommand" z tauri.conf.json tego repo (npm run
    -- build:tauri i tak to robi, ale kopiujemy jawnie na wypadek, gdyby
    -- danej wersji tego brakowało).
    sh("mkdir -p " .. quote(src .. "/src-tauri/icons"))
    sh("cp " .. quote(src .. "/images/icon.png") .. " " .. quote(src .. "/src-tauri/icons/icon.png"), true)

    -- VITE_BLUE_UI wybiera, którą powłokę (src/main.ts -> default, src/phones,
    -- src/tv) Vite wkompiluje do frontendu - patrz vite.config.ts w repo
    -- Blue-Environment. "default" jest tym samym, co brak zmiennej.
    sh("cd " .. quote(src) .. " && VITE_BLUE_UI=" .. quote(BLUE_ENV_UI) .. " npm run build:tauri")

    -- Binarka ląduje w target/ w KORZENIU workspace'a (src-tauri jest
    -- członkiem głównego Cargo.toml [workspace]), NIE w src-tauri/target -
    -- patrz analogiczny komentarz w .github/workflows/build.yml repo
    -- Blue-Environment.
    local built_bin = src .. "/target/release/blue-environment"
    sh("test -f " .. quote(built_bin) .. " || (echo 'Błąd: nie znaleziono " ..
        built_bin .. " po npm run build:tauri' >&2 && exit 1)")

    sh("cp " .. quote(built_bin) .. " " .. quote(dest))
end

-- Pobiera gotową binarkę blue-environment z GitHub Releases i zapisuje ją
-- do "dest". BLUE_ENV_VERSION == "latest" pyta GitHub API o najnowszy
-- release (jak HACKEROS_COMP_URL powyżej); w przeciwnym razie pobiera z
-- konkretnego, wskazanego tagu (domyślnie "v0.8" - dotychczasowe
-- zachowanie tego skryptu, sprzed dodania wyboru source/release).
local function download_blue_environment_release(dest)
    local url
    if BLUE_ENV_VERSION == "latest" then
        url = latest_release_asset_url(BLUE_ENVIRONMENT_REPO, "blue-environment")
    else
        url = "https://github.com/" .. BLUE_ENVIRONMENT_REPO ..
            "/releases/download/" .. BLUE_ENV_VERSION .. "/blue-environment"
    end
    heading("Pobieranie blue-environment z GitHub Releases (" .. BLUE_ENV_VERSION .. ")")
    download(url, dest)
end

--------------------------------------------------------------------------
-- 3. Pozyskujemy binarkę blue-environment do /usr/share/Blue-Environment
--    (source albo release - patrz BLUE_ENV_SOURCE na górze pliku)
--------------------------------------------------------------------------
do
    local dest = BLUE_DIR .. "/blue-environment"
    if BLUE_ENV_SOURCE == "source" then
        build_blue_environment_from_source(dest)
    elseif BLUE_ENV_SOURCE == "release" then
        download_blue_environment_release(dest)
    else
        io.stderr:write("Błąd: nieznana wartość BLUE_ENV_SOURCE: '" .. BLUE_ENV_SOURCE ..
            "' (oczekiwano 'source' albo 'release')\n")
        os.exit(1)
    end
    sh("chmod a+x " .. quote(dest))
end

--------------------------------------------------------------------------
-- 4. Pobieramy domyślną tapetę (best-effort - nie przerywamy builda, jeśli
--    ten konkretny plik akurat zniknął/zmienił ścieżkę w repo Blue-Environment;
--    tapeta jest kosmetyczna, w przeciwieństwie do samego środowiska).
--------------------------------------------------------------------------
download(WALLPAPER_URL, WALLPAPER_DIR .. "/default.png", true)

--------------------------------------------------------------------------
-- 5. Pobieramy hackeros-comp do /usr/bin
--------------------------------------------------------------------------
do
    local dest = BIN_DIR .. "/hackeros-comp"
    download(HACKEROS_COMP_URL, dest)
    sh("chmod a+x " .. quote(dest))
end

--------------------------------------------------------------------------
-- 5a. Pobieramy skrypty "blue" i "blue-dev" do /usr/bin
--------------------------------------------------------------------------
-- Oba są skryptami Lua (shebang: "lua" oraz "lua5.5"), więc w obrazie musi
-- być pakiet lua5.5 (jest w helpers/blue/package-lists/live.list.chroot);
-- blue-dev dodatkowo wywołuje zstd/tar/sha256sum (zstd dodany do tej samej
-- listy pakietów). Pobieranie jest twarde (bez allow_fail) - brak któregoś
-- z tych plików przerywa build, tak jak w przypadku hackeros-comp.
do
    heading("Pobieranie blue i blue-dev do /usr/bin")
    for _, name in ipairs({ "blue", "blue-dev" }) do
        local dest = BIN_DIR .. "/" .. name
        download(BLUE_TOOLS_BASE .. "/" .. name, dest)
        sh("chmod a+x " .. quote(dest))
    end
end

--------------------------------------------------------------------------
-- 6. Display manager: pobranie HDM (tylko hdm) + sprzątanie plików
--    NIEWYBRANYCH menedżerów z drzewa ISO.
--------------------------------------------------------------------------
-- POPRAWKA: wcześniej binarki HDM były pobierane ZAWSZE, więc przy wyborze
-- sddm build i tak próbował ściągnąć hdm (i wywalał się na 404). Teraz:
--   * hdm     -> pobieramy hdm + hdm-greeter do /usr/bin,
--   * pozostałe -> nic nie pobieramy, a pliki HDM skopiowane z helpers/blue
--                  (hdm.service, /etc/hdm) usuwamy z drzewa ISO, żeby nie
--                  zostawiać w obrazie jednostki wskazującej na nieistniejący
--                  /usr/bin/hdm (która ma Alias=display-manager.service).
-- Analogicznie usuwamy hooki i konfigurację lightdm/gdm, gdy wybrano inny
-- menedżer - hooki i tak same się pomijają (patrz plik-znacznik), ale
-- konfiguracja w /etc/lightdm albo /etc/gdm3 bez zainstalowanego pakietu
-- byłaby tylko śmieciem w obrazie.
local DM_FILES = {
    hdm = {
        "config/includes.chroot_after_packages/etc/systemd/system/hdm.service",
        "config/includes.chroot_after_packages/etc/hdm",
        "config/hooks/normal/hdm.hook.chroot",
    },
    lightdm = {
        "config/includes.chroot_after_packages/etc/lightdm",
        "config/hooks/normal/lightdm.hook.chroot",
    },
    gdm = {
        "config/includes.chroot_after_packages/etc/gdm3",
        "config/hooks/normal/gdm.hook.chroot",
    },
}

if BLUE_DEFAULT_DM == "hdm" then
    for _, name in ipairs({ "hdm", "hdm-greeter" }) do
        local dest = BIN_DIR .. "/" .. name
        download(HDM_BASE .. "/" .. name, dest)
        sh("chmod a+x " .. quote(dest))
    end
end

for dm, paths in pairs(DM_FILES) do
    if dm ~= BLUE_DEFAULT_DM then
        heading("Wybrano " .. BLUE_DEFAULT_DM .. " - usuwam pliki " .. dm .. " z drzewa ISO")
        for _, path in ipairs(paths) do
            sh("rm -rf " .. quote(path))
        end
    end
end

--------------------------------------------------------------------------
-- Dalej: właściwy build live-build
--------------------------------------------------------------------------

-- Debootstrap nie zna jeszcze "forky" jako takiego - podpinamy go pod skrypt "sid"
sh("sudo ln -sf /usr/share/debootstrap/scripts/sid /usr/share/debootstrap/scripts/forky")

-- Czyścimy poprzednie buildy
sh("sudo lb clean --purge")

-- Konfiguracja live-build z firmware i repo non-free-firmware
sh(
    "lb config " ..
    "--distribution forky " ..
    "--architectures amd64 " ..
    '--apt-options "--allow-unauthenticated --yes" ' ..
    "--firmware-chroot true " ..
    "--security false " ..
    '--debootstrap-options "--include=gnupg"'
)

-- Budowa obrazu
sh("sudo lb build")
