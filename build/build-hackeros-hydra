#!/usr/bin/env lua5.5

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd)
    io.write("+ " .. cmd .. "\n")
    local ok = os.execute(cmd)
    if ok ~= true and ok ~= 0 then
        io.stderr:write("Błąd: polecenie nie powiodło się: " .. cmd .. "\n")
        os.exit(1)
    end
    return true
end

-- === Przygotowanie: pobranie plików wyglądu (hydra-look-and-feel) ===

local repo_url  = "https://github.com/HackerOS-Linux-System/hydra-look-and-feel.git"
local clone_dir = "/tmp/hydra-look-and-feel"

-- Usuwamy ewentualną poprzednią kopię w /tmp, żeby klonowanie się nie wywaliło
sh("rm -rf " .. quote(clone_dir))

-- Klonujemy repozytorium do /tmp
sh("git clone --depth 1 " .. quote(repo_url) .. " " .. quote(clone_dir))

-- Upewniamy się, że katalog config/ istnieje w bieżącym miejscu wykonania skryptu
sh("mkdir -p config")

-- Kopiujemy całą zawartość katalogu files/ z repo do config/
sh("cp -r " .. quote(clone_dir .. "/files/.") .. " " .. quote("config/"))

-- Sprzątamy sklonowane repo z /tmp (opcjonalnie, ale porządkuje środowisko)
sh("rm -rf " .. quote(clone_dir))

-- === Właściwy proces budowania obrazu ===

-- Debootstrap nie zna jeszcze "forky" jako takiego - podpinamy go pod skrypt "sid"
sh("sudo ln -sf /usr/share/debootstrap/scripts/sid /usr/share/debootstrap/scripts/forky")

-- Czyścimy poprzednie buildy
sh("sudo lb clean --purge")

-- Konfiguracja live-build z firmware i repo non-free-firmware
sh(
    "lb config " ..
    "--distribution forky " ..
    "--architectures amd64 " ..
    '--apt-options "--allow-unauthenticated --yes" ' ..
    "--firmware-chroot true " ..
    "--security false"
)

-- Budowa obrazu
sh("sudo lb build")

-- Czyszczenie po buildzie
sh("sudo lb clean --purge")
