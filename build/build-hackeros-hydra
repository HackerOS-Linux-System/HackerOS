#!/usr/bin/env lua5.5

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd)
    io.write("+ " .. cmd .. "\n")
    local ok = os.execute(cmd)
    if ok ~= true and ok ~= 0 then
        io.stderr:write("Błąd: polecenie nie powiodło się: " .. cmd .. "\n")
        os.exit(1)
    end
    return true
end

-- === Przygotowanie: pliki wyglądu (hydra-look-and-feel) z lokalnego repo ===
--
-- Skrypt jest CAŁKOWICIE niezależny od zewnętrznych repozytoriów --
-- nic nie jest klonowane z sieci. Zamiast tego kopiujemy wprost
-- zawartość lokalnego katalogu helpers/hydra (dostarczonego w TYM
-- repo) do config/ -- dokładnie tak samo, jak robi to
-- step_hydra_pre_build()/copy_helper_dir() w build.lua dla innych
-- edycji (helpers/gaming, helpers/hydra, ...): "cp -r helpers/hydra/. config/".
-- Struktura helpers/hydra/includes.chroot_after_packages/... trafia
-- więc finalnie pod config/includes.chroot_after_packages/..., czyli
-- dokładnie tam, gdzie live-build faktycznie szuka tych plików.
local src_dir    = "helpers/hydra"
local target_dir = "config"

sh("mkdir -p " .. quote(target_dir))
sh("cp -r " .. quote(src_dir .. "/.") .. " " .. quote(target_dir .. "/"))

-- === Właściwy proces budowania obrazu ===

-- Debootstrap nie zna jeszcze "forky" jako takiego - podpinamy go pod skrypt "sid"
sh("sudo ln -sf /usr/share/debootstrap/scripts/sid /usr/share/debootstrap/scripts/forky")

-- Czyścimy poprzednie buildy
sh("sudo lb clean --purge")

-- Konfiguracja live-build z firmware i repo non-free-firmware
sh(
    "lb config " ..
    "--distribution forky " ..
    "--architectures amd64 " ..
    '--apt-options "--allow-unauthenticated --yes" ' ..
    "--firmware-chroot true " ..
    "--security false " ..
    '--debootstrap-options "--include=gnupg"'
)

-- Budowa obrazu
sh("sudo lb build")
