#!/usr/bin/env lua5.5

local WORKDIR = "/home/michal-hackeros/Pobrane/hackeros-official"

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

-- Wszystkie polecenia wykonujemy w kontekście WORKDIR (odpowiednik `cd` z bash,
-- które w Lua nie przetrwałoby między kolejnymi os.execute).
local function sh(cmd)
    local full = "cd " .. quote(WORKDIR) .. " && " .. cmd
    io.write("+ " .. full .. "\n")
    local ok = os.execute(full)
    if ok ~= true and ok ~= 0 then
        io.stderr:write("Błąd: polecenie nie powiodło się: " .. cmd .. "\n")
        os.exit(1)
    end
    return true
end

os.execute("clear")

-- Czyścimy poprzednie buildy
sh("sudo lb clean --purge")

-- Konfiguracja live-build z firmware i repo non-free-firmware
sh(
    "lb config " ..
    "--distribution trixie " ..
    "--architectures amd64 " ..
    '--apt-options "--allow-unauthenticated --yes" ' ..
    "--firmware-chroot true"
)

-- Budowa obrazu
sh("sudo lb build")

-- Czyszczenie po buildzie
sh("sudo lb clean --purge")
