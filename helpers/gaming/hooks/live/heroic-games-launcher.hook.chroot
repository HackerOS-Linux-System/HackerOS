#!/bin/sh
set -e

# Opcjonalne: wymuszenie braku interaktywności dla apt
export DEBIAN_FRONTEND=noninteractive

echo "=== Sprawdzanie wymaganych narzędzi ==="
for cmd in curl jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Błąd: Program '$cmd' nie jest zainstalowany."
    echo "Zainstaluj go poleceniem: apt-get install -y $cmd"
    exit 1
  fi
done

echo "=== Pobieranie najnowszej wersji Heroic Games Launcher ==="
REPO="Heroic-Games-Launcher/HeroicGamesLauncher"

# Pobranie URL najnowszego pliku .deb dla architektury amd64 z API GitHub
URL=$(curl -s "https://api.github.com/repos/${REPO}/releases/latest" \
  | jq -r '.assets[] | select(.name | endswith(".deb")) | select(.name | contains("amd64") or contains("x86_64")) | .browser_download_url' | head -n 1)

if [ -z "$URL" ] || [ "$URL" = "null" ]; then
  echo "Błąd: Nie udało się odnaleźć pliku .deb na GitHubie."
  exit 1
fi

OUTPUT="/tmp/heroic.deb"
echo "Pobieranie z: $URL"
curl -L -o "$OUTPUT" "$URL"

echo "=== Instalacja Heroic Games Launcher ==="
apt-get update
apt-get install -y "$OUTPUT"

echo "=== Czyszczenie po instalacji ==="
rm -f "$OUTPUT"
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "=== Zakończono pomyślnie ==="
