#!/bin/bash
# =====================================================================
# HackerOS-Red-Team-Tools.hook.chroot
# =====================================================================
#
# Pobiera i uruchamia ten sam oficjalny skrypt instalacyjny narzedzi
# cybersecurity co edycja pelna (patrz
# helpers/cybersecurity/hooks/normal/unpack-hackeros-cybersecurity-tools.hook.chroot),
# publikowany w repo:
#   https://github.com/HackerOS-Linux-System/cybersecurity-tools
#   (plik: scripts/for-editions/install.lua)
#
# Roznica dla edycji cybersecurity-default: skrypt jest uruchamiany
# z dodatkowa flaga "--default", ktora (wg skryptu install.lua)
# wybiera okrojony/dopasowany do tej edycji zestaw narzedzi red team
# zamiast pelnego zestawu instalowanego w edycji cybersecurity.
#
# Ten hook jest uruchamiany NIEZALEZNIE od
# unpack-hackeros-cybersecurity-tools.hook.chroot z edycji
# cybersecurity - ten drugi jest rowniez obecny w tej edycji (kopiowany
# przez build/build-hackeros-cybersecurity-default, ktory najpierw
# kopiuje helpers/cybersecurity/. do config/, a potem na to
# helpers/cybersecurity-default/.), ale uruchamia sie w etapie
# hooks/normal/, podczas gdy ten hook nalezy do hooks/live/ (razem z
# helpers/cybersecurity-default/hooks/live/build-red-team-tools.hook.chroot,
# ktory buduje narzedzia ze zrodel) - oba etapy wykonuja sie wiec w tym
# samym buildzie, jeden po drugim.
#
# Skrypt jest napisany w Lua i wykonywany interpreterem "lua5.5"
# (pakiet lua5.5 jest czescia bazowej listy pakietow - patrz
# config/package-lists/live.list.chroot - wiec jest obecny w chroot
# zanim ten hook sie wykona).
#
# Styl bledoodpornosci jest spojny z reszta hookow tej edycji
# (helpers/cybersecurity-default/hooks/live/build-red-team-tools.hook.chroot):
# brak globalnego "set -e" na poziomie calego pliku, zeby nieudane
# pobranie/wykonanie nie wywalilo calego builda ISO - blad jest tylko
# logowany.

set -u
export DEBIAN_FRONTEND=noninteractive

LOG_FILE="/var/log/hackeros-red-team-tools-unpack.log"
SCRIPT_URL="https://raw.githubusercontent.com/HackerOS-Linux-System/cybersecurity-tools/main/scripts/for-editions/install.lua"
WORK_DIR="$(mktemp -d /tmp/hackeros-red-team-tools.XXXXXX)"
SCRIPT_PATH="$WORK_DIR/install.lua"

mkdir -p "$(dirname "$LOG_FILE")"
: > "$LOG_FILE"
exec > >(tee -a "$LOG_FILE") 2>&1

cleanup() {
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT

echo "=== HackerOS-Red-Team-Tools.hook.chroot ==="
echo "Pobieranie: $SCRIPT_URL"

if ! curl -fsSL -A "HackerOS-red-team-tools-hook/1.0" -o "$SCRIPT_PATH" "$SCRIPT_URL"; then
    echo "BLAD: nie udalo sie pobrac $SCRIPT_URL" >&2
    exit 0
fi

if [ ! -s "$SCRIPT_PATH" ]; then
    echo "BLAD: pobrany plik install.lua jest pusty" >&2
    exit 0
fi

if ! command -v lua5.5 >/dev/null 2>&1; then
    echo "BLAD: interpreter 'lua5.5' nie jest dostepny w PATH - sprawdz czy pakiet" >&2
    echo "      lua5.5 jest obecny w package-lists tej edycji." >&2
    exit 0
fi

echo "=== Uruchamianie install.lua --default (edycja cybersecurity-default) ==="
if lua5.5 "$SCRIPT_PATH" --default; then
    echo "=== install.lua --default zakonczyl sie powodzeniem ==="
else
    echo "BLAD: install.lua --default zakonczyl sie bledem - sprawdz log powyzej." >&2
fi

exit 0
