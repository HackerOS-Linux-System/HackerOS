#!/bin/sh
# =====================================================================
# sddm-autologin.hook.chroot
# =====================================================================
#
# Konfiguruje SDDM tak, aby na edycji Blue:
#   1) odpalał się automatycznie na starcie systemu (odpowiednik
#      "systemctl enable" wykonywanego zwykle przez postinst pakietu -
#      w chroocie live-build nikt go za nas nie wywoła, więc robimy to
#      jawnie, tak samo jak np. helpers/gaming/hooks/normal/setup-gaming.hook.chroot
#      robi to dla hackeros-game-mode.service);
#   2) logował użytkownika "user" automatycznie, bez pytania o hasło
#      (patrz usr/lib/sddm/sddm.conf.d/autologin.conf, dostarczony razem
#      z tym hookiem przez includes.chroot_after_packages - system Live
#      i tak ma znane, jawne hasło "live" ustawiane w
#      config/hooks/normal/user-setup.hook.chroot, więc pytanie o nie
#      przy każdym starcie nie ma sensu).
#
# Sesja (Session=blue-environment.desktop) uruchamia bezposrednio
# /usr/share/Blue-Environment/blue-environment - patrz
# usr/share/wayland-sessions/blue-environment.desktop (pelna sciezka;
# wczesniej "Exec=blue-environment" nie bylo w PATH, przez co SDDM odrzucal
# sesje). Dawny blue-start.service zostal usuniety: "blue start" konczyl
# sie od razu, a systemd zabijal wtedy proces w tle.
#
# UWAGA: edycja Blue ma też HDM (patrz helpers/blue/hooks/normal/hdm.hook.chroot),
# który dotychczas pełnił rolę menedżera logowania. Oba menedżery mają w
# swoich jednostkach systemd "Alias=display-manager.service" - wygrywa
# ten, którego "systemctl enable" wykonano jako ostatnie (czyli - po
# nazwie pliku - ten hook, uruchamiany alfabetycznie po "hdm.hook.chroot").
# Jeśli docelowo ma zostać tylko jeden menedżer logowania, wystarczy
# usunąć/zmienić odpowiedni hook.
set -e

# Gdy wybrano HDM jako domyślny display manager - SDDM nie może go nadpisać.
DM="$(cat /etc/hackeros/blue-default-dm 2>/dev/null || echo sddm)"
if [ "$DM" != "sddm" ]; then
    echo "HackerOS Blue: domyślny DM = '$DM' - pomijam konfigurację SDDM."
    exit 0
fi

echo "========================================================"
echo "  HackerOS Blue: konfiguracja SDDM (autostart + autologin)..."
echo "========================================================"

# Nie pytaj interaktywnie (debconf) o domyślny menedżer logowania - w
# chroocie live-build i tak nie ma z kim "porozmawiać", a bez tego apt
# potrafi się zatrzymać w oczekiwaniu na odpowiedź.
export DEBIAN_FRONTEND=noninteractive

if command -v sddm >/dev/null 2>&1 || [ -x /usr/bin/sddm ]; then
    echo "/usr/bin/sddm" > /etc/X11/default-display-manager
    echo "sddm shared/default-x-display-manager select sddm" | debconf-set-selections || true
else
    echo "Ostrzeżenie: nie znaleziono /usr/bin/sddm - czy pakiet 'sddm' jest na" >&2
    echo "liście helpers/blue/package-lists/live.list.chroot?" >&2
fi

systemctl daemon-reload

# Skrypt zapisujacy autologin w sesji live (patrz blue-live-autologin.service).
chmod +x /usr/lib/hackeros/blue-live-autologin.sh 2>/dev/null || true
systemctl enable blue-live-autologin.service || \
    echo "Ostrzeżenie: nie udało się włączyć blue-live-autologin.service" >&2

# Skrot /usr/bin/blue-environment (sesja uzywa pelnej sciezki, ale skrot
# ulatwia uruchamianie recznie z terminala).
if [ -x /usr/share/Blue-Environment/blue-environment ] && [ ! -e /usr/bin/blue-environment ]; then
    ln -s /usr/share/Blue-Environment/blue-environment /usr/bin/blue-environment
fi

if [ -f /usr/lib/systemd/system/sddm.service ] || [ -f /etc/systemd/system/sddm.service ]; then
    systemctl enable sddm.service
else
    echo "Ostrzeżenie: /usr/lib/systemd/system/sddm.service nie istnieje - pomijam enable." >&2
fi

echo "========================================================"
echo "  HackerOS Blue: SDDM skonfigurowany (autologin + blue start)."
echo "========================================================"
