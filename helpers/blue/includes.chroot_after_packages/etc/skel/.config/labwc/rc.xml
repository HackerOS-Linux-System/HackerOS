<?xml version="1.0"?>
<!--
  Blue Environment — labwc configuration (generated default)

  Used when Blue Environment runs on the labwc backend
  (~/.config/Blue-Environment/config.hk  →  [backend] compositor => labwc).
  Blue Environment only generates this file when it does not exist yet, so
  edit it freely — it will never be overwritten. Delete it to get a fresh
  default back. Reload with:  labwc -r

  Every "@CTL@ ctl <cmd>" line below (the real flag is dash-dash-ctl) talks to
  the running Blue shell, so global shortcuts keep working even while a
  native (external) app has focus.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <placement>
    <policy>automatic</policy>
  </placement>

  <!-- Window chrome: matches Blue Environment's own windows
       (see themes/Blue-Environment/labwc/themerc) so native apps look at
       home next to built-in ones. -->
  <theme>
    <name>Blue-Environment</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow">
      <name>Inter</name>
      <size>10</size>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name>
      <size>10</size>
    </font>
    <font place="MenuItem">
      <name>Inter</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Inter</name>
      <size>10</size>
    </font>
  </theme>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range inner="10" outer="10"/>
    <topMaximize>yes</topMaximize>
  </snapping>

  <desktops>
    <popupTime>800</popupTime>
    <number>4</number>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <!-- Keeps native windows out from under the Blue top bar / dock. -->
  <margin top="@MARGIN_TOP@" bottom="@MARGIN_BOTTOM@" left="0" right="0"/>

  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no"/>

  <windowRules>
    <!-- The Blue shell itself: borderless and always behind native windows
         (it is the desktop). It stays visible to the toplevel protocol and to
         labwc's Alt+Tab on purpose: Blue can give itself keyboard focus, and
         Alt+Tab from a native app can get back to Blue's windows. The shell
         filters itself out of its own window list. -->
    <windowRule identifier="*blue*environment*" serverDecoration="no">
      <action name="ToggleAlwaysOnBottom"/>
    </windowRule>
  </windowRules>

  <keyboard>
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>

    <!-- Blue shell -->
    <!-- Win (tap) = app menu; second tap within ~350 ms = fullscreen app menu
         (the double-tap timing is handled by the shell: `super-tap`).
         Needs labwc >= 0.7 (onRelease). A Win+<key> combo does NOT fire it. -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="@CTL@ --ctl super-tap"/></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute" command="@CTL@ --ctl super-tap"/></keybind>
    <keybind key="W-space"><action name="Execute" command="@CTL@ --ctl toggle-start-menu"/></keybind>
    <keybind key="A-F1"><action name="Execute" command="@CTL@ --ctl toggle-start-menu"/></keybind>
    <keybind key="C-A-c"><action name="Execute" command="@CTL@ --ctl toggle-control-center"/></keybind>
    <keybind key="C-S-v"><action name="Execute" command="@CTL@ --ctl toggle-clipboard"/></keybind>
    <keybind key="C-A-t"><action name="Execute" command="@CTL@ --ctl open-terminal"/></keybind>
    <keybind key="Print"><action name="Execute" command="@CTL@ --ctl screenshot"/></keybind>
    <keybind key="W-l"><action name="Execute" command="@CTL@ --ctl lock"/></keybind>
    <keybind key="W-d"><action name="Execute" command="@CTL@ --ctl show-desktop"/></keybind>

    <!-- Alt+Tab. Two kinds of windows exist: native apps (labwc's windows) and
         Blue's own in-shell windows, which live inside the shell's single
         window. labwc's built-in switcher only knows the former, and a bound
         key never reaches the shell — so decide by who has focus:
           * the Blue shell is focused  -> hand the key to Blue's own switcher
             (it lists Blue windows AND native ones; Alt release commits);
           * a native app is focused    -> labwc's switcher, which also lists
             the "Blue Environment" entry so you can Alt+Tab back to Blue. -->
    <keybind key="A-Tab">
      <action name="If">
        <query identifier="*blue*environment*"/>
        <then><action name="Execute" command="@CTL@ --ctl switcher-next"/></then>
        <else><action name="NextWindow"/></else>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="If">
        <query identifier="*blue*environment*"/>
        <then><action name="Execute" command="@CTL@ --ctl switcher-prev"/></then>
        <else><action name="PreviousWindow"/></else>
      </action>
    </keybind>

    <!-- Native windows -->
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-Down"><action name="Iconify"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen"/></keybind>

    <!-- Workspaces: REAL compositor desktops (GoToDesktop), the shell is
         only told afterwards so it can mirror the state and show the OSD. -->
    <keybind key="W-Tab">
      <action name="GoToDesktop" to="right" wrap="yes"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync next"/>
    </keybind>
    <keybind key="W-S-Tab">
      <action name="GoToDesktop" to="left" wrap="yes"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync prev"/>
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 1"/>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 2"/>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 3"/>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 4"/>
    </keybind>
    <keybind key="W-5">
      <action name="GoToDesktop" to="5"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 5"/>
    </keybind>
    <keybind key="W-6">
      <action name="GoToDesktop" to="6"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 6"/>
    </keybind>
    <keybind key="W-7">
      <action name="GoToDesktop" to="7"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 7"/>
    </keybind>
    <keybind key="W-8">
      <action name="GoToDesktop" to="8"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 8"/>
    </keybind>
    <keybind key="W-9">
      <action name="GoToDesktop" to="9"/>
      <action name="Execute" command="@CTL@ --ctl workspace-sync 9"/>
    </keybind>
    <!-- Hidden binds used by the shell itself (workspace dots, hot corners)
         via `wtype`: Win+Alt+Shift+F<n> jumps to desktop n without any
         notification back (the shell already knows). -->
    <keybind key="W-A-S-F1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-A-S-F2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-A-S-F3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-A-S-F4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-A-S-F5"><action name="GoToDesktop" to="5"/></keybind>
    <keybind key="W-A-S-F6"><action name="GoToDesktop" to="6"/></keybind>
    <keybind key="W-A-S-F7"><action name="GoToDesktop" to="7"/></keybind>
    <keybind key="W-A-S-F8"><action name="GoToDesktop" to="8"/></keybind>
    <keybind key="W-A-S-F9"><action name="GoToDesktop" to="9"/></keybind>
    <keybind key="W-A-S-F10"><action name="GoToDesktop" to="10"/></keybind>
    <keybind key="W-A-S-F11"><action name="GoToDesktop" to="11"/></keybind>
    <keybind key="W-A-S-F12"><action name="GoToDesktop" to="12"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4"/></keybind>

    <!-- Media keys -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle"/></keybind>
    <!-- Media keys: playerctl drives whichever MPRIS player is active (Blue Music registers one); if playerctl is not installed, talk to Blue Music directly -->
    <keybind key="XF86AudioPlay"><action name="Execute" command="sh -c 'playerctl play-pause 2&gt;/dev/null || dbus-send --session --type=method_call --dest=org.mpris.MediaPlayer2.blue_music /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause'"/></keybind>
    <keybind key="XF86AudioPause"><action name="Execute" command="sh -c 'playerctl pause 2&gt;/dev/null || dbus-send --session --type=method_call --dest=org.mpris.MediaPlayer2.blue_music /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause'"/></keybind>
    <keybind key="XF86AudioStop"><action name="Execute" command="sh -c 'playerctl stop 2&gt;/dev/null || dbus-send --session --type=method_call --dest=org.mpris.MediaPlayer2.blue_music /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop'"/></keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="sh -c 'playerctl next 2&gt;/dev/null || dbus-send --session --type=method_call --dest=org.mpris.MediaPlayer2.blue_music /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next'"/></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="sh -c 'playerctl previous 2&gt;/dev/null || dbus-send --session --type=method_call --dest=org.mpris.MediaPlayer2.blue_music /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous'"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-"/></keybind>
  </keyboard>

  <mouse>
    <default/>
  </mouse>

</labwc_config>
