#!/bin/sh
set -e

echo "========================================================"
echo "  HackerOS: Rozpoczynanie konfiguracji systemu Live... "
echo "========================================================"

# 1. Włączanie usług systemowych (Systemd)
echo "[*] Włączanie usług systemowych..."
systemctl enable seatd.service
systemctl enable sddm.service
systemctl enable NetworkManager.service || systemctl enable wpa_supplicant.service

echo "========================================================"
echo "  HackerOS: Konfiguracja chroot zakończona sukcesem!    "
echo "========================================================"
