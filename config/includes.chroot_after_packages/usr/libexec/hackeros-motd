#!/usr/bin/hl

/// motd — HackerOS Message of the Day

using <gen 2>

;; MC — wyjdz jesli subshell Midnight Commander
> bash -c 'test -n "${MC_SID:-}"'
? ok
    > exit 0
done

% MOTD_DIR  = /usr/lib/HackerOS/motd
% TEMPLATE  = /usr/lib/HackerOS/motd/template/HackerOS.md
% THEME     = /usr/lib/HackerOS/motd/theme/default.json

::isdir @MOTD_DIR
? err
    > exit 0
done

;; Wybierz losowy tip
>> bash -c "ls /usr/lib/HackerOS/motd/*.md 2>/dev/null | shuf -n 1" |> @TIP_FILE

> test -z "@TIP_FILE"
? ok
    > exit 0
done
::exists @TIP_FILE
? err
    > exit 0
done

;; Wariant dystrybucji
>> bash -c "grep '^Variant=' /etc/xdg/kcm-about-distrorc 2>/dev/null | cut -d= -f2-" |> @DISTRO_VARIANT

;; Plik tymczasowy z podstawionym VARIANT
>> mktemp |> @TMP_FILE

::exists @TEMPLATE
? ok
    >> bash -c "sed \"s/%VARIANT%/@DISTRO_VARIANT/g\" '@TEMPLATE' > '@TMP_FILE'"
done
? err
    >> bash -c "touch '@TMP_FILE'"
done

;; Pipeline: wstaw TIP, zamien tyldy na newline, wyswietl przez glow
;; Dwa oddzielne -e zamiast bloku { } — unikamy { } w lekserze HL
>> bash -c "sed -e '/%TIP%/r @TIP_FILE' -e '/%TIP%/d' '@TMP_FILE' | tr '~' '\n' | /usr/bin/glow -s '@THEME' -w 78 -"

> rm -f @TMP_FILE
