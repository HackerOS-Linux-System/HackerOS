#!/usr/bin/hl
using <gen 1>
/// podhome — uruchamia kontener Podman z mapowaniem HOME (persistent)
;; Użycie: podhome [nazwa_obrazu] [opcjonalne_polecenie]

;; Sprawdzenie argumentów
> test @argc -lt 1
? ok
    ::red Użycie: podhome [nazwa_obrazu] [opcjonalne_polecenie]
    ~> Przykład: podhome fedora
    ~>          podhome ubuntu /bin/zsh
    > exit 1
done

% IMAGE = @arg0

;; Domyślna komenda
% COMMAND = /bin/bash

;; Jeśli podano dodatkowe argumenty — bierzemy pierwszy jako komendę
> test @argc -gt 1
? ok
    % COMMAND = @arg1
done

;; Generowanie bezpiecznej nazwy kontenera (bez echo)
> printf '%s' "@IMAGE" | tr '/:' '-' > /tmp/podhome-safe-name
> cat /tmp/podhome-safe-name
% SAFE_IMAGE = @_          ;; wynik ostatniej komendy trafia do @_
% CONTAINER_NAME = podhome-@SAFE_IMAGE

;; Sprawdzamy czy kontener już istnieje
> podman container exists @CONTAINER_NAME 2>/dev/null
? err
    ~> Tworzę nowy kontener: @CONTAINER_NAME
    > podman create \
        --name @CONTAINER_NAME \
        -v @HOME:@HOME:Z \
        @IMAGE sleep infinity
done

~> Wchodzę do kontenera: @CONTAINER_NAME
> podman start @CONTAINER_NAME >/dev/null

;; Exec — wchodzimy do kontenera
> podman exec -it @CONTAINER_NAME @COMMAND
