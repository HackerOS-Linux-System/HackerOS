#!/bin/bash
set -e

# Ustawia motyw Plymouth "spinner" jako domyślny zamiast domyślnego
# motywu Debiana, zarówno na starcie systemu, jak i przy jego
# wyłączaniu/restarcie (theme spinner obsługuje sekcje [boot-up],
# [shutdown] i [reboot] w swoim pliku spinner.plymouth).
#
# Same pliki motywu (grafiki + spinner.plymouth) są dostarczane przez
# config/includes.chroot_after_packages/usr/share/plymouth/themes/spinner/
# - ten hook tylko rejestruje ten motyw w update-alternatives i przebudowuje
# initramfs, żeby Plymouth faktycznie z niego skorzystał.
#
# Pakiety "plymouth" ORAZ "plymouth-themes" muszą być obecne w systemie
# (patrz config/package-lists/live.list.chroot). Sam "plymouth" daje tylko
# silnik + kilka podstawowych motywów tekstowych - moduł graficzny
# "two-step" (używany przez motyw spinner) jest w pakiecie
# "plymouth-themes" (plik /usr/lib/<triplet>/plymouth/two-step.so).

THEME="spinner"
THEME_DIR="/usr/share/plymouth/themes/${THEME}"
THEME_FILE="${THEME_DIR}/${THEME}.plymouth"

if [ ! -f "$THEME_FILE" ]; then
    echo "Błąd: nie znaleziono ${THEME_FILE} - motyw spinner nie został dograny do chroota." >&2
    exit 1
fi

if ! command -v plymouth-set-default-theme >/dev/null 2>&1; then
    echo "Błąd: brak polecenia plymouth-set-default-theme - czy pakiet 'plymouth' jest zainstalowany?" >&2
    exit 1
fi

# Sprawdź, czy moduł wymagany przez motyw (np. ModuleName=two-step) jest
# fizycznie obecny jako .so - jeśli nie, plymouth-set-default-theme i tak
# się wywali, więc lepiej dać od razu jasny, konkretny komunikat błędu.
MODULE_NAME=$(sed -n 's/^ModuleName=//p' "$THEME_FILE" | head -n1 | tr -d '[:space:]')

if [ -n "$MODULE_NAME" ]; then
    MODULE_FOUND=""
    for dir in /usr/lib/*/plymouth /usr/lib/plymouth; do
        if [ -f "${dir}/${MODULE_NAME}.so" ]; then
            MODULE_FOUND="${dir}/${MODULE_NAME}.so"
            break
        fi
    done

    if [ -z "$MODULE_FOUND" ]; then
        echo "Błąd: nie znaleziono modułu Plymouth '${MODULE_NAME}.so' wymaganego przez motyw '${THEME}'." >&2
        echo "Najprawdopodobniej brakuje pakietu 'plymouth-themes' (ten moduł jest w nim," >&2
        echo "a nie w samym pakiecie 'plymouth'). Sprawdź config/package-lists/live.list.chroot." >&2
        exit 1
    fi

    echo "Znaleziono wymagany moduł Plymouth: ${MODULE_FOUND}"
fi

# "-R" ustawia motyw i od razu przebudowuje initramfs (odpowiednik
# ręcznego update-initramfs -u). Gdyby z jakiegoś powodu nie
# przebudowało initramfs (np. inna wersja plymouth), robimy to jawnie
# poniżej jako zabezpieczenie.
plymouth-set-default-theme -R "$THEME"

# Zabezpieczenie: upewnij się, że initramfs faktycznie zawiera nowy motyw.
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi

echo "Domyślny motyw Plymouth ustawiony na: ${THEME}"
